#!/bin/bash

read -r -d '' usage << EOF
    __    ____  ____  ______
   / /   / __ \/ __ \/ ____/
  / /   / / / / /_/ / __/   
 / /___/ /_/ / _, _/ /___   
/_____/\____/_/ |_/_____/   

Locator of Recorded Exploits

HackTricks: lore -t (-s) [page or word]
GTFOBins:   lore -g (-f) [name or file]
LOLBAS:     lore -l (-f) [name or file]
EOF

cloud=./hacktricks-cloud
hacktricks=./hacktricks
gtfobins=./gtfobins
lolbas=./lolbas

bold() {
  text=$(</dev/stdin)
  bld=$(tput bold)
  nrm=$(tput sgr0)
  
  echo "${bld}$text${nrm}"
}

mkbox() {
read -r -d '' pytxt << EOF
import sys

def bold(text):
  return f"\\033[1m{text}\\033[0m"

def mkbox(val, style, line):
  vlen = len(val)
  cols = vlen + 2

  if style == '-b':
    val = bold(val)
    h = '━'
    v = '┃'
    lt = '┣'
    rt = '┫'
    ut = '┳'
    dt = '┻'
    ct = '╋'
    c1 = '┏'
    c2 = '┓'
    c3 = '┗'
    c4 = '┛'
  else:
    h = '─'
    v = '│'
    lt = '├'
    rt = '┤'
    ut = '┬'
    dt = '┴'
    ct = '┼'
    c1 = '┌'
    c2 = '┐'
    c3 = '└'
    c4 = '┘'

  sect = h * cols
  if cols % 2 == 0:
    line_s = h * int(cols / 2 - 1) + ut + h * int(cols / 2)
  else:
    line_s = h * int(cols / 2) + ut + h * int(cols / 2)

  if line == 'n':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  elif line == 'e':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  elif line == 's':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{line_s}{c4}"
  elif line == 'w':
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"
  else:
    top = f"{c1}{sect}{c2}"
    mid = f"\\n{v} {val} {v}"
    bot = f"\\n{c3}{sect}{c4}"

  return f"{top}{mid}{bot}"

if sys.argv[1] == '-b':
  print(mkbox(sys.argv[2], '-b', ''))
elif sys.argv[1] == '-h':
  print(mkbox(sys.argv[3], '', sys.argv[2]))
else:
  print(mkbox(sys.argv[1], '', ''))
EOF

  python3 -c "$pytxt" $@
}

search_hacktricks() {
  cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" || exit
  temp=$(mktemp)
  temp_dir=$(mktemp -d)

  if [[ "$htc" -eq 1 ]]; then
    hacktricks="$cloud"
  fi
  
  if [[ "$1" != '-k' ]]; then
    for x in $(fdfind "$1" $hacktricks | rg -v '/pdfs/'); do
      if echo "$x" | rg -q '\.md$'; then
        name=$(echo "$x" | sd '\.md$' '' | sd '.*/' '')
        cp "$x" "$temp_dir/$name"
      else
        name=$(echo "$x" | sd '/$' '' | sd '.*/' '')
        cp "$x/README.md" "$temp_dir/$name"
      fi
    done
  else
    for x in $(rg -li "$2" $hacktricks | rg md$); do
      if echo "$x" | rg -q 'README\.md$'; then
        name=$(echo "$x" | sd '/README\.md$' '' | sd '.*/' '')
      else
        name=$(echo "$x" | sd '\.md$' '' | sd '.*/' '')
      fi
      cp "$x" "$temp_dir/$name"
    done
  fi
  
  if [[ -z $(ls -A "$temp_dir") ]]; then
    rm "$temp"
    rm -r "$temp_dir"
    exit
  fi
  
  ranger --choosefile="$temp" "$temp_dir"
  choice=$(cat "$temp")
  cat "$choice" | glow -p
  
  rm "$temp"
  rm -r "$temp_dir"
}

search_gtfobins() {
  cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" || exit
  if [[ -f "$gtfobins/_gtfobins/$1" ]]; then
    mkbox -b "$1"

    readcmd=$(cat "$gtfobins/_gtfobins/$1" | ./yq -o=json | sd 'file-read' 'read' | jq -r '.functions.read[].code' 2>/dev/null)
    writecmd=$(cat "$gtfobins/_gtfobins/$1" | ./yq -o=json | sd 'file-write' 'write' | jq -r '.functions.write[].code' 2>/dev/null)
    shellcmd=$(cat "$gtfobins/_gtfobins/$1" | ./yq -o=json | jq -r '.functions.shell[].code' 2>/dev/null)
    cmdcmd=$(cat "$gtfobins/_gtfobins/$1" | ./yq -o=json | jq -r '.functions.command[].code' 2>/dev/null)
    result=''
  
    if [[ -n "$readcmd" ]]; then
      echo -e "$(echo Read: | bold)\n$readcmd\n"
    fi
  
    if [[ -n "$writecmd" ]]; then
      echo -e "$(echo Write: | bold)\n$writecmd\n"
    fi
  
    if [[ -n "$shellcmd" || -n "$cmdcmd" ]]; then
      echo "$(echo Exec: | bold)"

      if [[ -n "$shellcmd" ]]; then
        echo -e "$shellcmd\n"
      fi

      if [[ -n "$cmdcmd" ]]; then
        echo -e "$cmdcmd\n"
      fi
    fi
  fi
}

search_lolbas() {
  cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" || exit
  search=$(fdfind "$1" $lolbas/yml | rg -i "/$1.yml$")

  if [[ -n "$search" ]]; then
    mkbox -b "$1"

    cmds=$(echo "$search" | xargs ./yq -o=json | jq -r '.Commands[].Command' 2>/dev/null | sd '\\' '\\\\')
    path=$(echo "$search" | xargs ./yq -o=json | jq -r '.Full_Path[].Path' 2>/dev/null | sd '\\' '/' | sd '^C:' '')
    result=''
  
    if [[ -n "$cmds" ]]; then
      echo -e "$(echo Commands: | bold)\n$cmds\n"
    fi
  
    if [[ -n "$path" ]]; then
      echo -e "$(echo Location: | bold)\n$path\n"
    fi
  fi
}

OPTIONS=$(getopt -o tcgls:f:h --long help -- "$@" 2>/dev/null)

ht=0
gb=0
lb=0
keyword=''
fileloc=''

while getopts 'tcgls:f:h' opt; do
  case ${opt} in
    t) ht=1 ;;
    c) htc=1 ;;
    g) gb=1 ;;
    l) lb=1 ;;
    s) keyword="$OPTARG" ;;
    f) fileloc="$OPTARG" ;;
    h) echo "    $usage"; echo; exit 1 ;;
  esac
done 2>/dev/null

shift $((OPTIND - 1))

if [[ "$ht" -eq 1 ]]; then
  if [[ -z "$keyword" ]]; then
    search_hacktricks "$1"
  else
    search_hacktricks -k "$keyword"
  fi
elif [[ "$gb" -eq 1 ]]; then
  if [[ -z "$fileloc" ]]; then
    search_gtfobins "$1" | head -n -1
  else
    for x in $(cat "$fileloc"); do
      search=$(search_gtfobins "$x" | head -n -1)
      if [[ -n "$search" ]]; then
        echo "$search"
        echo
      fi
    done | head -n -1
  fi
elif [[ "$lb" -eq 1 ]]; then
  if [[ -z "$fileloc" ]]; then
    search_lolbas "$1" | head -n -1
  else
    for x in $(cat "$fileloc"); do
      search=$(search_lolbas "$x")
      if [[ -n "$search" ]]; then
        echo "$search"
        echo
      fi
    done | head -n -1
  fi
else
  echo "    $usage"; echo; exit 1
fi
